---
import '../styles/global.css';
import { site } from '../data/site';
import { fileVersion } from '../lib/assets';
import { videos } from '../data/videos';
import { defaultImage, personSchema, serializeJsonLd, type JsonLd } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Sets article:published_time. Pass for dated articles such as blog posts. */
  publishedTime?: Date;
  /** JSON-LD for this page. The home page gets the Person record by default. */
  structuredData?: JsonLd | JsonLd[];
  /** Ask search engines not to index this page. */
  noindex?: boolean;
  /** Links shown after the home link at the top of inner pages, e.g. the section a page belongs to. */
  trail?: { href: string; label: string }[];
  /** Use the wider column, for pages such as the video grid. */
  wide?: boolean;
}

const { title, description = site.description, type = 'website', publishedTime, structuredData, noindex = false, trail = [], wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.shortName}` : site.title;
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin);
const path = Astro.url.pathname;

const image = new URL(defaultImage.path, origin);

// The script URL carries a hash of the file, so browsers fetch a new copy whenever it changes.
const trailVersion = fileVersion('public/trail.js');
const rippleVersion = fileVersion('public/ripple.js');
const themeVersion = fileVersion('public/theme.js');
const portraitVersion = fileVersion('public/me.jpg');
const hasVideos = videos.length > 0;
const jsonLd = structuredData ? [structuredData].flat() : path === '/' ? [personSchema(origin)] : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.shortName} — Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(defaultImage.width)} />
    <meta property="og:image:height" content={String(defaultImage.height)} />
    <meta property="og:image:alt" content={defaultImage.alt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={defaultImage.alt} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#fcfcfa" />
    {/* Not deferred on purpose: it picks day or night before the page is first drawn. */}
    <script is:inline src={`/theme.js?v=${themeVersion}`}></script>
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="corner">
      {
        hasVideos && (
          <a class="corner-link" href="/videos/" aria-label="Videos" title="Videos" aria-current={path.startsWith('/videos/') ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3" />
              <path d="M10.5 9.5v5l4.2-2.5Z" />
            </svg>
          </a>
        )
      }
      <a class="corner-link" href="/resume/" aria-label="CV" title="CV" aria-current={path.startsWith('/resume/') ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M14 3H7.5A1.5 1.5 0 0 0 6 4.5v15A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V7Z" />
          <path d="M14 3v4h4M9 12h6M9 15.5h6" />
        </svg>
      </a>
      <button class="theme-toggle" type="button" aria-label="Switch to night mode" aria-pressed="false">
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
        </svg>
      </button>
    </div>
    {
      path !== '/' && (
        <header class:list={[wide ? 'wide' : 'wrap', 'crumb']}>
          <nav aria-label="Breadcrumb">
            <a href="/">{site.shortName}</a>
            {trail.map((item) => (
              <>
                <span aria-hidden="true">/</span>
                <a href={item.href}>{item.label}</a>
              </>
            ))}
          </nav>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>
    <script is:inline defer src={`/trail.js?v=${trailVersion}`} data-portrait={`/me.jpg?v=${portraitVersion}`}></script>
    <script is:inline defer src={`/ripple.js?v=${rippleVersion}`}></script>
    <slot name="scripts" />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: var(--space-2);
    background: var(--text);
    color: var(--bg);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    z-index: 10;
  }
  .skip:focus {
    left: var(--space-2);
  }
  /* Small icons in the top-right corner of the window: videos, and the day/night switch. */
  .corner {
    position: fixed;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 5;
    display: flex;
    gap: var(--space-1);
  }
  .corner-link,
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--transition);
  }
  .corner-link:hover,
  .corner-link[aria-current='page'],
  .theme-toggle:hover {
    color: var(--text);
  }
  .corner svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Show the moon by day (press for night) and the sun by night. */
  .theme-toggle .sun,
  :global([data-theme='dark']) .theme-toggle .moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle .sun {
    display: block;
  }
  /* Inner pages get one quiet line back to the home page instead of a menu bar. */
  .crumb {
    padding-top: var(--space-page);
    margin-bottom: calc(var(--space-6) - var(--space-page));
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .crumb nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-2);
  }
  .crumb a {
    text-decoration-color: transparent;
  }
  .crumb a:hover {
    color: var(--text);
    text-decoration-color: currentColor;
  }
  /* Phones and touch screens: the links are about 44px tall. */
  @media (max-width: 40rem), (pointer: coarse) {
    .crumb a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }
  @media print {
    .crumb,
    .skip,
    .corner {
      display: none;
    }
  }
</style>
