---
import '../styles/global.css';
import { site, nav } from '../data/site';
import { defaultImage, personSchema, serializeJsonLd, type JsonLd } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Sets article:published_time. Pass for dated articles such as blog posts. */
  publishedTime?: Date;
  /** JSON-LD for this page. The home page gets the Person record by default. */
  structuredData?: JsonLd | JsonLd[];
  /** Ask search engines not to index this page. */
  noindex?: boolean;
}

const { title, description = site.description, type = 'website', publishedTime, structuredData, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin);
const path = Astro.url.pathname;

const image = new URL(defaultImage.path, origin);
const jsonLd = structuredData ? [structuredData].flat() : path === '/' ? [personSchema(origin)] : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(defaultImage.width)} />
    <meta property="og:image:height" content={String(defaultImage.height)} />
    <meta property="og:image:alt" content={defaultImage.alt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={defaultImage.alt} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#faf6ee" />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={serializeJsonLd(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">{site.shortName}<span aria-hidden="true">.</span></a>
        <nav aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap bar">
        <p class="muted">© {new Date().getFullYear()} {site.name}</p>
        <ul>
          <li><a href={`mailto:${site.email}`}>Email</a></li>
          <li><a href={site.links.github} rel="me noopener">GitHub</a></li>
          <li><a href={site.links.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: var(--space-2);
    background: var(--accent);
    color: var(--accent-ink);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    z-index: 10;
  }
  .skip:focus {
    left: var(--space-2);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
  }
  .site-header {
    padding-block: var(--space-5);
    border-bottom: var(--border);
  }
  .brand {
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    text-decoration: none;
  }
  .brand span {
    color: var(--accent);
  }
  ul {
    display: flex;
    gap: var(--space-1) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a,
  .site-footer a {
    font-size: var(--text-sm);
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  .site-footer a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .site-footer {
    border-top: var(--border);
    padding-block: var(--space-6);
    font-size: var(--text-sm);
  }
  .site-footer p {
    margin: 0;
  }
  /* Phones and touch screens: header and footer links are about 44px tall. Desktop is unchanged. */
  @media (max-width: 40rem), (pointer: coarse) {
    .brand,
    nav a,
    .site-footer a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
    .bar {
      align-items: center;
    }
    .site-header {
      padding-block: var(--space-1);
    }
    .site-footer {
      padding-block: var(--space-3);
    }
  }
  @media print {
    .site-header,
    .site-footer,
    .skip {
      display: none;
    }
  }
</style>
