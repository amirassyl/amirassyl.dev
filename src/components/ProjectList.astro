---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="list">
  {
    projects.map((project) => (
      <li>
        <a class="title-link" href={`/projects/${project.id}/`}>
          {project.data.title}
        </a>
        <p>{project.data.summary}</p>
      </li>
    ))
  }
</ul>

<style>
  li > * {
    grid-column: 1 / -1;
  }
</style>
