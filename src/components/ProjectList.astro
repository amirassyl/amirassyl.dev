---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
  /** Heading level for project titles, so the outline fits the page. */
  heading?: 'h2' | 'h3';
}

const { projects, heading: Heading = 'h3' } = Astro.props;
---

<ul class="projects">
  {
    projects.map((project) => (
      <li>
        <Heading class="title">
          <a class="title-link" href={`/projects/${project.id}/`}>
            {project.data.title}
          </a>
        </Heading>
        <p class="summary muted">{project.data.summary}</p>
        <p class="meta stack">
          {project.data.context}
          {' · '}
          {project.data.stack.slice(0, 5).join(' · ')}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    padding-block: var(--space-3);
  }
  .title {
    display: inline;
    font-size: var(--text-base);
    letter-spacing: 0;
    margin: 0;
  }
  .summary {
    display: inline;
    font-size: var(--text-sm);
    margin: 0 0 0 var(--space-3);
  }
  .stack {
    margin: 0;
  }
</style>
