---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { site, experience } from '../data/site';
import { getProjects, getPosts } from '../lib/content';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 5);
---

<Base>
  <div class="wrap page">
    <h1 class="name">{site.shortName}</h1>
    <div class="intro">
      <p>
        I study Computational Sciences at Minerva University, and I move countries every year. This year
        that's Japan, and I'm currently in Tokyo.
      </p>
      <p>
        Last year I built the front end of an exhibit prototype for the Exploratorium. 
        It talks you through your emotions (<a href="https://elevenlabs.io/conversational-ai">@ElevenLabs</a>), 
        and then guides you through yoga poses (<a href="https://developers.google.com/edge/mediapipe/solutions/vision/pose_landmarker">@MediaPipe</a>). 
        Before that I wrote C++ for a robotics team in Kazakhstan, where I'm from.
      </p>
      <p>
        I'm looking for a software engineering internship for summer 2027. I'll be in San Francisco, and anywhere
        in the US works.
      </p>
    </div>

    <section class="section">
      <h2 class="label">Projects</h2>
      <ProjectList projects={projects} />
    </section>

    <section class="section">
      <h2 class="label">Experience</h2>
      <ul class="list">
        {
          experience.map((job) => (
            <li>
              <h3 class="org">{job.org}</h3>
              <span class="aside num">{job.period}</span>
              <p>{job.role}</p>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/resume/">Full résumé</a></p>
    </section>

    {
      posts.length > 0 && (
        <section class="section">
          <h2 class="label">Writing</h2>
          <PostList posts={posts} />
        </section>
      )
    }

    <section class="section">
      <h2 class="label">Contact</h2>
      <p>
        Outside of code I play classical guitar and piano. <br />
        Say hi:{' '}
        <a href={`mailto:${site.email}`}>Email</a>,{' '}
        <a href={site.links.linkedin} rel="noopener">LinkedIn</a>,{' '}
        <a href={site.links.github} rel="noopener">GitHub</a>,{' '}
        <a href={site.links.telegram} rel="noopener">Telegram</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  /* The name is the same size as the text around it, as a quiet title. */
  .name {
    font-size: var(--text-base);
    margin-bottom: var(--space-5);
  }
  .intro p:last-child {
    margin-bottom: 0;
  }
  .org {
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    line-height: var(--leading);
    margin: 0;
  }
  .more {
    margin: var(--space-5) 0 0;
  }
  section > p:last-child {
    margin-bottom: 0;
  }
</style>
