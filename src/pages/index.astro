---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { site, experience } from '../data/site';
import { getProjects, getPosts } from '../lib/content';

const projects = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero wrap">
    <h1>{site.name}</h1>
    <div class="lede">
      <p>
        I study Computational Sciences at Minerva University, which moves to a new country every year. This year
        that's Japan, and I live in Tokyo.
      </p>
      <p>
        Last year I built the front end of an exhibit prototype for the Exploratorium. It tracks your pose through
        the camera and a voice guide talks you through it. Before that I wrote C++ for a robotics team in
        Kazakhstan, where I'm from.
      </p>
      <p>
        I'm looking for a software engineering internship for summer 2027. I'll be in San Francisco, and anywhere
        in the US works.
      </p>
    </div>
    <div class="actions">
      <a href="/projects/">See projects</a>
      <a href="/resume/">Résumé</a>
      <a href={`mailto:${site.email}`}>Email me</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected projects</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <ProjectList projects={projects} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
        <a href="/resume/">Full résumé →</a>
      </div>
      <ol class="rows">
        {
          experience.map((job) => (
            <li>
              <span class="meta">{job.period}</span>
              <div>
                <h3>{job.org}</h3>
                <p class="muted">{job.role}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <h2>Writing</h2>
            <a href="/blog/">All posts →</a>
          </div>
          <PostList posts={posts} />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap contact">
      <h2>Contact</h2>
      <p class="muted">Outside of code I play classical guitar and piano. Say hi:</p>
      <div class="actions">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.links.linkedin} rel="noopener">LinkedIn</a>
        <a href={site.links.github} rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-page);
  }
  .hero h1 {
    max-width: 20ch;
  }
  .lede {
    margin-top: var(--space-5);
  }
  .lede p:last-child {
    margin-bottom: 0;
  }
</style>
