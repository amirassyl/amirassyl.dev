---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { site, experience } from '../data/site';
import { getProjects, getPosts } from '../lib/content';

const projects = (await getProjects()).filter((p) => p.data.featured);
const posts = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero wrap">
    <p class="meta">{site.status}</p>
    <h1>Amirassyl Sagyndyk builds software you can see, hear, and <em>move through</em>.</h1>
    <p class="lede">
      I study Computational Sciences at Minerva University, a programme that moves between cities. I'm from
      Kazakhstan, in Tokyo this semester, and back in San Francisco for summer 2027. I like work where math meets
      an interface: pose tracking in the browser, numerical solvers written from scratch, real-time 3D.
    </p>
    <div class="actions">
      <a href="/projects/">See projects</a>
      <a href="/resume/">Résumé</a>
      <a href={`mailto:${site.email}`}>Email me</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected projects</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <ProjectList projects={projects} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Experience</h2>
        <a href="/resume/">Full résumé →</a>
      </div>
      <ol class="rows">
        {
          experience.map((job) => (
            <li>
              <span class="meta">{job.period}</span>
              <div>
                <h3>{job.org}</h3>
                <p class="muted">{job.role}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <h2>Writing</h2>
            <a href="/blog/">All posts →</a>
          </div>
          <PostList posts={posts} />
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap contact">
      <h2>Get in touch</h2>
      <p class="muted">
        I'm looking for a software engineering internship for summer 2027, anywhere in the US. I'm eligible for CPT.
        The fastest way to reach me is email.
      </p>
      <div class="actions">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.links.linkedin} rel="noopener">LinkedIn</a>
        <a href={site.links.github} rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-page);
  }
  .hero h1 {
    max-width: 18ch;
    font-weight: var(--weight-medium);
    line-height: 1.12;
    margin-block: var(--space-4) var(--space-5);
  }
  .hero .lede::first-line {
    font-variant-caps: small-caps;
    letter-spacing: 0.04em;
  }
  .hero .actions {
    font-style: italic;
  }
  .hero em {
    font-style: italic;
  }
  .lede {
    margin-top: var(--space-5);
  }
</style>
