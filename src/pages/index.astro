---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import Ripple from '../components/Ripple.astro';
import { site, experience } from '../data/site';
import { getProjects, getPosts } from '../lib/content';
import { videos } from '../data/videos';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 5);
// The link to the videos page appears once there is at least one video to show.
const hasVideos = videos.length > 0;
---

<Base>
  <div class="wrap page">
    <h1 class="name ripple-big" aria-label={site.shortName} data-me data-ripple data-ripple-stagger="45">
      <Ripple text={site.shortName} />
    </h1>
    <div class="intro">
      <p>
        I study Computational Sciences{' '}
        <a href="https://www.minerva.edu/about/" rel="noopener" aria-label="@Minerva University" data-ripple>
          <Ripple text="@Minerva University" />
        </a>
        , and I move countries every year. This year
        that's <span class="place" data-place="jp">Japan</span>, and I'm currently in{' '}
        <span class="place" data-place="jp">Tokyo</span>.
      </p>
      <p>
        Last year I built the front end of an exhibit prototype for the Exploratorium. 
        It talks you through your emotions (<a href="https://elevenlabs.io/conversational-ai" rel="noopener" aria-label="@ElevenLabs" data-ripple><Ripple text="@ElevenLabs" /></a>), 
        and then guides you through yoga poses (<a href="https://developers.google.com/edge/mediapipe/solutions/vision/pose_landmarker" rel="noopener" aria-label="@MediaPipe" data-ripple><Ripple text="@MediaPipe" /></a>). 
        Before that I wrote C++ for a robotics team in <span class="place" data-place="kz">Kazakhstan</span>, where I'm from.
      </p>
      <p>
        I'm looking for a software engineering internship for summer 2027. I'll be in{' '}
        <span class="place" data-place="sf">San Francisco</span>, and anywhere
        in the US works.
      </p>
    </div>

    <section class="section">
      <h2 class="label">Projects</h2>
      <ProjectList projects={projects} />
    </section>

    <section class="section">
      <h2 class="label">Experience</h2>
      <ul class="list">
        {
          experience.map((job) => (
            <li>
              <h3 class="org">{job.org}</h3>
              <span class="aside num">{job.period}</span>
              <p>{job.role}</p>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/resume/" aria-label="Full résumé" data-ripple><Ripple text="Full résumé" /></a></p>
    </section>

    {
      posts.length > 0 && (
        <section class="section">
          <h2 class="label">Writing</h2>
          <PostList posts={posts} />
        </section>
      )
    }

    <section class="section">
      <h2 class="label">Contact</h2>
      <p>
        Outside of code I play classical guitar and piano{hasVideos && <>, and <a href="/videos/" aria-label="edit videos" data-ripple><Ripple text="edit videos" /></a></>}. <br />
        Say hi:{' '}
        <a href={`mailto:${site.email}`}>Email</a>,{' '}
        <a href={site.links.linkedin} rel="noopener">LinkedIn</a>,{' '}
        <a href={site.links.github} rel="noopener">GitHub</a>,{' '}
        <a href={site.links.telegram} rel="noopener">Telegram</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  /* The name is the same size as the text around it, as a quiet title. */
  .name {
    font-size: var(--text-base);
    margin-bottom: var(--space-5);
    width: fit-content;
    cursor: default;
  }
  /* Place names take their place's colour when pointed at; trail.js turns the
     cursor dots into the matching flag (or bridge) at the same time. */
  .place {
    cursor: default;
    white-space: nowrap; /* keep a two-word name on one line, so it is one hover target */
    transition: color 0.25s ease;
  }
  .place[data-place='kz']:hover {
    color: var(--place-kz);
  }
  .place[data-place='jp']:hover {
    color: var(--place-jp);
  }
  .place[data-place='sf']:hover {
    color: var(--place-sf);
  }
  .intro p:last-child {
    margin-bottom: 0;
  }
  .org {
    font-weight: var(--weight-medium);
    letter-spacing: 0;
    line-height: var(--leading);
    margin: 0;
  }
  .more {
    margin: var(--space-5) 0 0;
  }
  section > p:last-child {
    margin-bottom: 0;
  }
</style>
