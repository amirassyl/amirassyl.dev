---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import { projectSchema } from '../../lib/structured-data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, metaDescription, context, period, stack, repo, demo } = project.data;
const { Content } = await render(project);
const structuredData = projectSchema(project, Astro.site!);
---

<Base title={title} description={metaDescription ?? summary} type="article" structuredData={structuredData} trail={[{ href: '/projects/', label: 'Projects' }]}>
  <article class="wrap page">
    <header>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <p class="meta details">{context} · {period} · {stack.join(', ')}</p>
      <div class="actions">
        {demo && <a href={demo} rel="noopener">Live prototype</a>}
        {repo && <a href={repo} rel="noopener">Source on GitHub</a>}
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  header {
    margin-bottom: var(--space-7);
  }
  .lede {
    margin-bottom: var(--space-3);
  }
  .details {
    margin: 0;
  }
</style>
