---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import { projectSchema } from '../../lib/structured-data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, metaDescription, context, period, stack, repo, demo } = project.data;
const { Content } = await render(project);
const structuredData = projectSchema(project, Astro.site!);
---

<Base title={title} description={metaDescription ?? summary} type="article" structuredData={structuredData}>
  <article class="wrap page">
    <header>
      <p class="meta"><a href="/projects/">Projects</a> / {context}</p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <dl>
        <div><dt>When</dt><dd>{period}</dd></div>
        <div>
          <dt>Stack</dt>
          <dd>{stack.join(', ')}</dd>
        </div>
      </dl>
      <div class="actions">
        {demo && <a href={demo} rel="noopener">Live prototype</a>}
        {repo && <a href={repo} rel="noopener">Source on GitHub</a>}
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  header {
    margin-bottom: var(--space-6);
  }
  h1 {
    font-size: var(--text-2xl);
  }
  dl {
    margin: var(--space-4) 0 0;
    padding-block: var(--space-3);
    border-block: var(--border);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  dl div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: baseline;
  }
  dt {
    font-size: var(--text-xs);
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .actions {
    margin-top: var(--space-4);
  }
</style>
