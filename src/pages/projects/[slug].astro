---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import { projectSchema } from '../../lib/structured-data';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, metaDescription, context, period, stack, repo, demo } = project.data;
const { Content } = await render(project);
const structuredData = projectSchema(project, Astro.site!);
---

<Base title={title} description={metaDescription ?? summary} type="article" structuredData={structuredData}>
  <article class="narrow">
    <header>
      <p class="eyebrow"><a href="/projects/">Projects</a> / {context}</p>
      <h1>{title}</h1>
      <p class="lede muted">{summary}</p>
      <dl>
        <div><dt>When</dt><dd>{period}</dd></div>
        <div>
          <dt>Stack</dt>
          <dd><ul class="tags">{stack.map((s) => <li>{s}</li>)}</ul></dd>
        </div>
      </dl>
      <div class="actions">
        {demo && <a class="btn primary" href={demo} rel="noopener">Live prototype</a>}
        {repo && <a class="btn" href={repo} rel="noopener">Source on GitHub</a>}
      </div>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  article {
    padding-block: clamp(3rem, 9vw, 5.5rem);
  }
  .eyebrow a {
    text-decoration: none;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lede {
    font-size: 1.15rem;
  }
  dl {
    margin: 1.5rem 0;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
    display: grid;
    gap: 0.75rem;
  }
  dl div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  dt {
    font: 0.75rem var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }
</style>
