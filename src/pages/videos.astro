---
import Base from '../layouts/Base.astro';
import { fileVersion } from '../lib/assets';
import { getVideos } from '../lib/videos';

const videos = getVideos();
// Wide videos first, then tall ones in their own row so every row has tiles of one shape.
const groups = [
  { vertical: false, items: videos.filter((video) => !video.vertical) },
  { vertical: true, items: videos.filter((video) => video.vertical) },
].filter((group) => group.items.length > 0);
const scriptVersion = fileVersion('public/videos.js');
---

<Base title="Videos" description="Videos I've edited." noindex={videos.length === 0} wide>
  <section class="wide page">
    <header class="intro">
      <h1>Videos</h1>
      <p class="muted">Things I've edited. Hover for a preview, click to watch with sound.</p>
    </header>

    {
      videos.length === 0 ? (
        <p class="muted">Nothing here yet.</p>
      ) : (
        <>
          {groups.map((group) => (
            <ul class:list={['grid', { tall: group.vertical }]}>
              {group.items.map((video) => (
                <li>
                  <a
                    class="frame"
                    href={video.watchUrl}
                    data-video={video.full ? undefined : video.id}
                    data-file={video.full}
                    data-title={video.title}
                    data-vertical={video.vertical ? '' : undefined}
                    rel="noopener"
                  >
                    <img src={video.poster} alt="" loading="lazy" decoding="async" />
                    {video.clip && (
                      <video src={video.clip} muted loop playsinline preload="none" tabindex="-1" aria-hidden="true" />
                    )}
                    <span class="sr-only">Play {video.title}</span>
                  </a>
                  <div class="caption">
                    <span class="title">{video.title}</span>
                    <span class="year num">{video.year}</span>
                  </div>
                  {video.note && <p class="note">{video.note}</p>}
                </li>
              ))}
            </ul>
          ))}
        </>
      )
    }
  </section>

  {/* The full video plays here after a click: from YouTube, or from this site for hosted files. */}
  <dialog class="player" aria-label="Video player">
    <button class="close" type="button">Close</button>
    <div class="stage"></div>
  </dialog>

  <script slot="scripts" is:inline defer src={`/videos.js?v=${scriptVersion}`}></script>
</Base>

<style>
  .intro {
    margin-bottom: var(--space-6);
  }
  .intro p {
    margin: 0;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-6) var(--space-5);
  }
  .grid + .grid {
    margin-top: var(--space-7);
  }
  /* Tall videos get narrower tiles in a row of their own. */
  .grid.tall {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
  }
  .tall .frame {
    aspect-ratio: 9 / 16;
  }
  .frame {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    /* Resting: a sheet lying flat, with only a hairline shadow. */
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.14);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.2),
      box-shadow 0.45s ease;
  }
  /* Hover: the sheet lifts off the table. It rises, tips back a little, and its
     shadow drops away and softens underneath. Neighbours tip opposite ways. */
  .frame:hover,
  .frame:focus-visible {
    transform: perspective(60rem) translateY(-0.7rem) rotateX(5deg) rotate(var(--tilt, -0.9deg)) scale(1.02);
    box-shadow:
      0 1.6rem 1.8rem -1rem rgb(0 0 0 / 0.32),
      0 0.6rem 0.8rem -0.5rem rgb(0 0 0 / 0.18);
  }
  li:nth-child(even) .frame {
    --tilt: 0.9deg;
  }
  @media (prefers-reduced-motion: reduce) {
    .frame {
      transition: none;
    }
    .frame:hover,
    .frame:focus-visible {
      transform: none;
    }
  }
  .frame img,
  .frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The preview sits on top of the still image and fades in once it is playing. */
  .frame video {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .frame:global(.playing) video {
    opacity: 1;
  }
  .caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }
  .title {
    font-weight: var(--weight-medium);
  }
  .year {
    font-size: var(--text-sm);
    color: var(--muted);
  }
  .note {
    margin: 0;
    color: var(--muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .player {
    width: min(100% - 2 * var(--gutter), 70rem);
    max-width: none;
    padding: 0;
    border: 0;
    background: none;
    overflow: visible;
  }
  .player::backdrop {
    background: rgb(0 0 0 / 0.82);
  }
  /* A tall video gets a tall player that fits the window height. */
  .player:global(.tall) {
    width: min(100% - 2 * var(--gutter), calc((100vh - 6rem) * 9 / 16));
  }
  .player:global(.tall) .stage {
    aspect-ratio: 9 / 16;
  }
  .stage {
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stage :global(iframe),
  .stage :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .close {
    display: block;
    margin: 0 0 var(--space-2) auto;
    padding: var(--space-2) 0;
    border: 0;
    background: none;
    color: #fff;
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  @media print {
    .player {
      display: none;
    }
  }
</style>
