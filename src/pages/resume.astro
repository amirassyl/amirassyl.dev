---
import Base from '../layouts/Base.astro';
import { site, experience, education, skills } from '../data/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<Base title="Résumé" description="Résumé of Amirassyl Sagyndyk: experience, education, projects, and skills.">
  <article class="wrap page resume">
    <header class="split">
      <h1 class="full">{site.name}</h1>
      <p class="muted">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {' · '}
        <a href={site.links.linkedin} rel="noopener">linkedin.com/in/amirassyl</a>
        {' · '}
        <a href={site.links.github} rel="noopener">github.com/amirassyl</a>
      </p>
      <p class="muted">Eligible for CPT.</p>
      <button class="btn print" type="button" onclick="window.print()">Print / save as PDF</button>
    </header>

    <section class="split">
      <h2 class="label side">Experience</h2>
      {
        experience.map((job) => (
          <div class="entry">
            <div class="row">
              <h3>{job.org}</h3>
              <span class="meta">{job.period}</span>
            </div>
            <p class="role">{job.role}</p>
            <ul>{job.points.map((point) => <li>{point}</li>)}</ul>
          </div>
        ))
      }
    </section>

    <section class="split">
      <h2 class="label side">Education</h2>
      {
        education.map((school) => (
          <div class="entry">
            <div class="row">
              <h3>{school.org}</h3>
              <span class="meta">{school.period}</span>
            </div>
            <p class="role">{school.detail}</p>
            <ul>{school.points.map((point) => <li>{point}</li>)}</ul>
          </div>
        ))
      }
    </section>

    <section class="split">
      <h2 class="label side">Projects</h2>
      {
        projects.map((project) => (
          <div class="entry">
            <div class="row">
              <h3><a class="title-link" href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
              <span class="meta">{project.data.period}</span>
            </div>
            <p class="role">{project.data.stack.slice(0, 5).join(', ')}</p>
            <p>{project.data.summary}</p>
          </div>
        ))
      }
    </section>

    <section class="split">
      <h2 class="label side">Skills</h2>
      <dl>
        {
          skills.map((skill) => (
            <div>
              <dt>{skill.group}</dt>
              <dd>{skill.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </article>
</Base>

<style>
  h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }
  header p {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
  }
  .print {
    justify-self: start;
    margin-top: var(--space-4);
  }
  section {
    margin-top: var(--space-7);
  }
  h2 {
    margin-bottom: var(--space-4);
  }
  .entry {
    margin-bottom: var(--space-5);
  }
  .entry:last-child {
    margin-bottom: 0;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--space-4);
    flex-wrap: wrap;
  }
  h3 {
    margin: 0;
    font-size: var(--text-base);
  }
  .row .meta {
    margin: 0;
  }
  .role {
    color: var(--muted);
    margin: var(--space-1) 0 var(--space-2);
    font-size: var(--text-sm);
  }
  ul {
    margin: 0;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
  }
  li {
    margin-bottom: var(--space-1);
  }
  .entry > p:last-child {
    margin: 0;
    font-size: var(--text-sm);
  }
  dl {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  dl div {
    display: grid;
    grid-template-columns: var(--col-label) minmax(0, 1fr);
    gap: var(--space-4);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
  }
  @media (max-width: 34rem) {
    dl div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
  @media print {
    :global(body) {
      font-size: 10.5pt;
    }
    .print {
      display: none;
    }
    .resume {
      padding: 0;
      width: 100%;
    }
    section {
      margin-top: 1.1rem;
    }
    .entry {
      break-inside: avoid;
      margin-bottom: 0.8rem;
    }
  }
</style>
