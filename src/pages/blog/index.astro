---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base title="Writing" description="Notes on what I'm building and learning.">
  <section class="wrap page">
    <p class="meta">Writing</p>
    <h1>Notes</h1>
    <p class="muted intro">What I'm building and learning. <a href="/rss.xml">Subscribe by RSS</a>.</p>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">Nothing published yet.</p>}
  </section>
</Base>

<style>
  .intro {
    margin-bottom: var(--space-5);
  }
</style>
