# Applied by Cloudflare Workers static assets. Rules that match a request are
# merged, and a header set by more than one rule gets its values joined, so
# Cache-Control is kept out of the catch-all rule and given per-path rules.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), autoplay=(self "https://www.youtube-nocookie.com"), camera=(), display-capture=(), fullscreen=(self "https://www.youtube-nocookie.com"), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), usb=(), xr-spatial-tracking=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://i.ytimg.com; media-src 'self'; frame-src https://www.youtube-nocookie.com; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# HTML: revalidate quickly so a deploy shows up within minutes.
/
  Cache-Control: public, max-age=300, must-revalidate
/:a/
  Cache-Control: public, max-age=300, must-revalidate
/:a/:b/
  Cache-Control: public, max-age=300, must-revalidate

# Fingerprinted by Astro, so the URL changes whenever the content does.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fixed URLs, so only a moderate lifetime.
/og-default.png
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/trail.js
  Cache-Control: public, max-age=3600
/ripple.js
  Cache-Control: public, max-age=3600
/videos.js
  Cache-Control: public, max-age=3600

# Preview clips and their still frames; the file name is the YouTube video ID.
/clips/*
  Cache-Control: public, max-age=86400
/theme.js
  Cache-Control: public, max-age=3600
/Amirassyl-Sagyndyk-CV.pdf
  Cache-Control: public, max-age=3600
/me.jpg
  Cache-Control: public, max-age=86400
