{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amirassyl-com",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // Once amirassyl.dev is added to Cloudflare as a zone, attach it here
  // (add a comma after the "assets" block above):
  // "routes": [{ "pattern": "amirassyl.dev", "custom_domain": true }]
}
